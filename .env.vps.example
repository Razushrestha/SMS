# Copy to .env on the Namecheap VPS. Do not commit real passwords.
# DNS: sms.meroauction.com and api.meroauction.com → VPS A record.

NODE_ENV=production
COOKIE_SECURE=1
TRUST_PROXY=1
API_HOST=127.0.0.1
API_PORT=4000

WEB_ORIGIN=https://sms.meroauction.com
NEXT_PUBLIC_API_URL=https://api.meroauction.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@meroauction.com

PLATFORM_ADMIN_EMAIL=platform@meroauction.com
PLATFORM_ADMIN_PASSWORD=change-this-strong-password

# Host Postgres on the VPS (both URLs can match).
POSTGRES_USER=nepatronix
POSTGRES_DB=nepatronix
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://nepatronix:change-this-db-password@127.0.0.1:5432/nepatronix
DATABASE_URL_UNPOOLED=postgresql://nepatronix:change-this-db-password@127.0.0.1:5432/nepatronix
